<!-- Created with Jaspersoft Studio version 7.0.6.final using JasperReports Library version 7.0.6-5d2a603fdc6b3db8f842a83383e594f41891534d  -->
<jasperReport name="booking_summary_report" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="fd5060b0-0107-42ad-9139-3d3918c78c4d">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TourEase_MySQL"/>
	<query language="SQL"><![CDATA[SELECT
                b.booking_id,
                c.full_name AS customer_name,
                r.room_number,
                r.room_type,
                IFNULL(p.package_name, 'No Package') AS package_name,
                b.checkin_date,
                b.checkout_date,
                DATEDIFF(b.checkout_date, b.checkin_date) AS nights,
                b.total_amount,
                b.status
            FROM bookings b
            JOIN customers c ON b.customer_id = c.customer_id
            JOIN rooms r ON b.room_id = r.room_id
            LEFT JOIN packages p ON b.package_id = p.package_id
            ORDER BY b.booking_date DESC]]></query>
	<field name="booking_id" class="java.lang.Integer"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="room_number" class="java.lang.String"/>
	<field name="room_type" class="java.lang.String"/>
	<field name="package_name" class="java.lang.String"/>
	<field name="checkin_date" class="java.sql.Date"/>
	<field name="checkout_date" class="java.sql.Date"/>
	<field name="nights" class="java.lang.Integer"/>
	<field name="total_amount" class="java.math.BigDecimal"/>
	<field name="status" class="java.lang.String"/>
	<variable name="GRAND_TOTAL" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{total_amount}]]></expression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal("0.00")]]></initialValueExpression>
	</variable>
	<variable name="RECORD_COUNT" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{booking_id}]]></expression>
	</variable>

<!-- Created with Jaspersoft Studio version 7.0.6.final using JasperReports Library version 7.0.6-5d2a603fdc6b3db8f842a83383e594f41891534d  -->
<jasperReport name="package_revenue_report" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="9027bde1-1d20-4b01-935a-37787fb8b5a2">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TourEase_MySQL"/>
	<query language="SQL"><![CDATA[SELECT
                p.package_id,
                p.package_name,
                p.destination,
                p.duration_days,
                p.price AS package_price,
                p.status AS package_status,
                COUNT(b.booking_id) AS total_bookings,
                COALESCE(SUM(py.amount), 0) AS total_revenue,
                COALESCE(AVG(py.amount), 0) AS avg_payment
            FROM packages p
            LEFT JOIN bookings b ON p.package_id = b.package_id
                AND b.status != 'CANCELLED'
            LEFT JOIN payments py ON b.booking_id = py.booking_id
            GROUP BY p.package_id, p.package_name, p.destination,
                     p.duration_days, p.price, p.status
            ORDER BY total_revenue DESC]]></query>
	<field name="package_id" class="java.lang.Integer"/>
	<field name="package_name" class="java.lang.String"/>
	<field name="destination" class="java.lang.String"/>
	<field name="duration_days" class="java.lang.Integer"/>
	<field name="package_price" class="java.math.BigDecimal"/>
	<field name="package_status" class="java.lang.String"/>
	<field name="total_bookings" class="java.lang.Long"/>
	<field name="total_revenue" class="java.math.BigDecimal"/>
	<field name="avg_payment" class="java.math.BigDecimal"/>
	<variable name="GRAND_REVENUE" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{total_revenue}]]></expression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal("0.00")]]></initialValueExpression>
	</variable>
	<variable name="GRAND_BOOKINGS" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{total_bookings}]]></expression>
	</variable>
	<variable name="MAX_REVENUE" calculation="Highest" class="java.math.BigDecimal">
		<expression><![CDATA[$F{total_revenue}]]></expression>
	</variable>
